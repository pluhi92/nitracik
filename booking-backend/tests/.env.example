# Príklad konfigurácie pre testy
# Skopírujte tento súbor ako .env do koreňového priečinka backendu (booking-backend/.env)

# ⚠️  DÔLEŽITÉ: Pre testy použite SAMOSTATNÚ testovaciu databázu!
# Produkcia musí byť úplne oddelená.

# Možnosť 1: Použiť samostatnú testovaciu databázu (odporúčané)
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/nitracik_test

# Možnosť 2: Alebo nastaviť DB_NAME obsahujúce "test"
# DB_NAME=nitracik_test

# Štandardná databázová konfigurácia
DB_USER=postgres
DB_HOST=localhost
DB_PASSWORD=your_password
DB_PORT=5432
